{
  "name": "mdv-markdown-viewer",
  "version": "1.0.0",
  "description": "Markdown Viewer Pro",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.igor4z4.mdv",
    "productName": "MDV Markdown Viewer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "preload.js",
      "web/**/*",
      "!node_modules/.bin"
    ],
    "win": {
      "target": "nsis",
      "icon": "web/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "katex": "^0.19.0",
    "markdown-it": "^14.3.3",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-multimd-table": "^4.2.3",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "markdown-it-texmath": "^1.0.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
