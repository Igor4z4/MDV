{
  "name": "mdv-markdown-viewer",
  "version": "1.0.1",
  "description": "Markdown Viewer Pro",
  "main": "index.js",
  "author": "Igor4",
  "scripts": {
    "start": "electron .",
    "setup": "node setup.js",
    "dist": "cross-env ELECTRON_BUILDER_CACHE=./.cache/builder ELECTRON_CACHE=./.cache/electron electron-builder --win nsis portable --x64",
    "dist:arm": "cross-env ELECTRON_BUILDER_CACHE=./.cache/builder ELECTRON_CACHE=./.cache/electron electron-builder --win nsis portable --arm64"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.igor4z4.mdv",
    "productName": "MDV Markdown Viewer",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "index.js",
      "preload.js",
      "web/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis" },
        { "target": "portable" }
      ],
      "icon": "web/favicon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MDV Markdown Viewer",
      "uninstallDisplayName": "MDV Markdown Viewer",
      "artifactName": "MDV-Markdown-Viewer-${version}-setup.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "MDV-Markdown-Viewer-${version}-portable.${ext}"
    }
  }
}