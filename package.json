{
  "name": "mdv-markdown-viewer",
  "version": "1.0.1",
  "description": "Markdown Viewer Pro",
  "main": "index.js",
  "author": "Igor4",
  "scripts": {
    "start": "electron .",
    "install-electron": "node node_modules/electron/install.js",
    "dist": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.igor4z4.mdv",
    "productName": "MDV Markdown Viewer",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.js",
      "preload.js",
      "web/**/*"
    ],
    "win": {
      "target": "dir",
      "signAndEditExecutable": false
    }
  }
}