{
  "name": "mdv-markdown-viewer",
  "version": "1.0.1",
  "description": "Markdown Viewer Pro",
  "main": "index.js",
  "author": "Igor4",
  "scripts": {
  "start": "electron .",
  "setup": "node setup.js",
  "dist": "cross-env ELECTRON_BUILDER_CACHE=./.cache/builder ELECTRON_CACHE=./.cache/electron electron-builder --win portable --x64",
  "dist:arm": "cross-env ELECTRON_BUILDER_CACHE=./.cache/builder ELECTRON_CACHE=./.cache/electron electron-builder --win portable --arm64"
},
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0"
  },
  "build": {
    "appId": "com.igor4z4.mdv",
    "productName": "MDV Markdown Viewer",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "index.js",
      "preload.js",
      "web/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "web/favicon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "MDV-Markdown-Viewer-${version}-portable.${ext}"
    }
  }
}
